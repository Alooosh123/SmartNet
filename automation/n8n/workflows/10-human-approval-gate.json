        "jsCode": "const r=$json||{};const ai_context={agent:r.agent||'10-human-approval-gate',status:r.status,action:r.action||null,approver_role:r.approver_role||null,backend_durable_approval_required:r.backend_durable_approval_required===true,target_provided:r.target_present===true||!!r.target,reason_provided:r.reason_present===true||!!r.reason,execution_performed:false};return [{json:{ai_context}}];"
