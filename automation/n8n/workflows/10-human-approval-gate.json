        "jsCode": "const x=$json.body??$json;const allowed=['router_reboot','disconnect_user','firewall_change','hotspot_user_create','payment_approval','subscription_activation','database_restore','production_deploy'];const a=String(x.action||'');const targetPresent=x.target_present===true||!!x.target;const reasonPresent=x.reason_present===true||!!x.reason;if(!allowed.includes(a))return [{json:{agent:'10-human-approval-gate',status:'rejected_unknown_action',action:a,target:null,reason:null,target_present:targetPresent,reason_present:reasonPresent,execution_performed:false}}];return [{json:{agent:'10-human-approval-gate',status:'awaiting_human_approval',request_id:x.request_id||'approval-'+Date.now(),action:a,target:null,reason:null,target_present:targetPresent,reason_present:reasonPresent,approver_role:['payment_approval','subscription_activation'].includes(a)?'finance_or_owner':'owner_or_network_admin',backend_durable_approval_required:true,execution_performed:false}}];"
