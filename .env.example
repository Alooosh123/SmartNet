# Copy to backend/.env for local development or create a protected production env file.
# Never commit real passwords, API keys or router credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

SECRET_KEY=dev-only-change-me-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PAYMENT_WEBHOOK_SECRET=dev-only-change-me-before-production
PAYMENT_PROVIDER_MODE=manual
PAYMENT_CHECKOUT_URL=
PAYMENT_DEMO_MODE=true
APP_PUBLIC_URL=http://127.0.0.1:5173

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=dev-only-SmartNet-Admin-Change-This-2026!

# Development uses SQLite. Production MUST use MariaDB 11.8 LTS:
# mysql+asyncmy://smartnet_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/smartnet?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./smartnet.db
# Optional DDL-capable account used only by "alembic upgrade head".
# Set this to a separate smartnet_migrator account in production.
MIGRATION_DATABASE_URL=

# Backup scripts read these values. Keep them in the protected service environment.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=smartnet
MARIADB_USER=smartnet_backup
MARIADB_PASSWORD=change-this-backup-readonly-secret
MARIADB_RESTORE_USER=smartnet_restore
MARIADB_RESTORE_PASSWORD=change-this-different-restore-secret
MARIADB_BACKUP_DIR=./backups

MIKROTIK_DEMO_MODE=true
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=smartnet-operator
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8729
# Dedicated read-only RouterOS account for the Network Observer.
# API-SSL (8729 by default) is mandatory; certificate and hostname checks stay enabled.
# Leave blank to use the operating-system CA trust store, or supply a private CA PEM path.
MIKROTIK_TLS_CA_FILE=
MIKROTIK_READONLY_HOST=
MIKROTIK_READONLY_USERNAME=smartnet-observer
MIKROTIK_READONLY_PASSWORD=
MIKROTIK_READONLY_PORT=8729
SSID=SmartNet-WiFi

NETWORK_OBSERVER_ENABLED=true
NETWORK_OBSERVER_INTERVAL_SECONDS=60
NETWORK_OBSERVER_HISTORY_LIMIT=500
NETWORK_ALERT_CPU_THRESHOLD=85
NETWORK_ALERT_FREE_MEMORY_MB=32

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
# Pydantic list format: JSON array of numeric Telegram user IDs.
TELEGRAM_ADMIN_IDS=[]
BOT_API_BASE_URL=http://127.0.0.1:8000

SUBSCRIPTION_AGENT_DELAY_SECONDS=60
SUBSCRIPTION_AGENT_INTERVAL_SECONDS=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
