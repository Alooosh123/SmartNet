# Local development defaults. Never commit a real .env file.
ENVIRONMENT=development
LOG_LEVEL=INFO

SECRET_KEY=dev-only-change-me-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PAYMENT_WEBHOOK_SECRET=dev-only-change-me-before-production
PAYMENT_PROVIDER_MODE=manual
PAYMENT_CHECKOUT_URL=
PAYMENT_DEMO_MODE=true
APP_PUBLIC_URL=http://127.0.0.1:5173

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=dev-only-SmartNet-Admin-Change-This-2026!

# Local: sqlite. Production: mariadb (connection password is passed separately).
DATABASE_BACKEND=sqlite
DATABASE_URL=
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=smartnet
MARIADB_USER=smartnet
MARIADB_PASSWORD=dev-only-local-password-change-me

MIKROTIK_DEMO_MODE=true
MIKROTIK_HOST=192.168.88.1
MIKROTIK_MONITOR_USERNAME=smartnet-monitor
MIKROTIK_MONITOR_PASSWORD=
MIKROTIK_OPERATOR_USERNAME=smartnet-operator
MIKROTIK_OPERATOR_PASSWORD=
MIKROTIK_PORT=8729
MIKROTIK_USE_SSL=true
MIKROTIK_SSL_VERIFY=true
MIKROTIK_SSL_VERIFY_HOSTNAME=true
SSID=SmartNet-WiFi

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=[]
BOT_API_BASE_URL=http://127.0.0.1:8000

NETWORK_MONITOR_ENABLED=false
NETWORK_MONITOR_INTERVAL_SECONDS=60
NETWORK_CPU_ALERT_THRESHOLD=85
NETWORK_ACTIVE_USERS_ALERT_THRESHOLD=500
NETWORK_ALERT_COOLDOWN_SECONDS=900
METRICS_ENABLED=true
METRICS_TOKEN=dev-only-prometheus-token-set-a-random-32-plus-character-value
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

SUBSCRIPTION_AGENT_DELAY_SECONDS=60
SUBSCRIPTION_AGENT_INTERVAL_SECONDS=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Podman HTTPS entrypoint
DOMAIN=smartnet.example.com
ACME_EMAIL=admin@example.com
MARIADB_ROOT_PASSWORD=dev-only-root-password-change-me
