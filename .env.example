# Development template only. Replace dev-only values before deployment.
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=dev-only-change-me-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PAYMENT_WEBHOOK_SECRET=dev-only-change-me-before-production
PAYMENT_PROVIDER_MODE=manual
PAYMENT_CHECKOUT_URL=
PAYMENT_DEMO_MODE=true
APP_PUBLIC_URL=http://127.0.0.1:5173

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=dev-only-SmartNet-Admin-Change-This-2026!

# MariaDB production placeholders (must be replaced)
MARIADB_DATABASE=smartnet
MARIADB_USER=smartnet
MARIADB_PASSWORD=dev-only-mariadb-password-change-before-production
MARIADB_ROOT_PASSWORD=dev-only-mariadb-root-password-change-before-production
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-password-change-before-production
DATABASE_URL=sqlite+aiosqlite:///./smartnet.db

# MikroTik: split read-only monitoring and control identities
MIKROTIK_DEMO_MODE=true
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=smartnet-control
MIKROTIK_PASSWORD=
MIKROTIK_READ_USERNAME=smartnet-observer
MIKROTIK_READ_PASSWORD=
MIKROTIK_PORT=8728
MIKROTIK_USE_SSL=false
MIKROTIK_TEST_PROFILE=SmartNet-Test
SSID=SmartNet-WiFi

NETWORK_MONITOR_ENABLED=false
NETWORK_MONITOR_INTERVAL_SECONDS=60
NETWORK_CPU_ALERT_THRESHOLD=85
NETWORK_FREE_MEMORY_ALERT_PERCENT=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=[]
BOT_API_BASE_URL=http://127.0.0.1:8000
SUBSCRIPTION_AGENT_DELAY_SECONDS=60
SUBSCRIPTION_AGENT_INTERVAL_SECONDS=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]
SMARTNET_HTTP_PORT=8080
